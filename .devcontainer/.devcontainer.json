{
  "name": "Foundations of Image Systems Engineering",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/mathworks/devcontainer-features/matlab:0": {
      "release": "r2024b",
      "products": "MATLAB Image_Processing_Toolbox Signal_Processing_Toolbox Optimization_Toolbox"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MathWorks.language-matlab",
        "quarto.quarto"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}